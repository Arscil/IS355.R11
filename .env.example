# Sao chép file này thành .env rồi điền giá trị. KHÔNG commit file .env.

# Sepolia RPC URL (Alchemy hoặc Infura; endpoint công cộng rpc.sepolia.org thường không ổn định)
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/<API_KEY>"

# Etherscan API key để verify contract
ETHERSCAN_API_KEY=""

# Private key của 5 ví test (chỉ dùng ví testnet, KHÔNG dùng ví thật).
# Thứ tự trong hardhat.config.js: Admin, Importer, Issuing Bank, Exporter, Advising Bank
PRIVATE_KEY_ADMIN=""
PRIVATE_KEY_IMPORTER=""
PRIVATE_KEY_ISSUING_BANK=""
PRIVATE_KEY_EXPORTER=""
PRIVATE_KEY_ADVISING_BANK=""

# Số token TFUSD nạp cho Importer khi deploy (đơn vị token, 18 decimals)
INITIAL_IMPORTER_FUNDS="1000000"

# Pinata IPFS (dùng ở giai đoạn 5)
PINATA_JWT=""
PINATA_GATEWAY="https://gateway.pinata.cloud"

# Passphrase mã hóa file RSA private key trong keys/ (để trống = không mã hóa)
KEY_PASSPHRASE=""

# Giá gas cố định trên Sepolia (gwei). Để trống = auto (Hardhat trả tip 1 gwei, khá tốn)
SEPOLIA_GAS_PRICE_GWEI="0.05"
